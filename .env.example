# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Saytning to'liq manzili (parolni tiklash havolalari uchun)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keyingi bosqichlar uchun (hozircha bo'sh qolishi mumkin)
SUPABASE_SERVICE_ROLE_KEY=
# AI funksiyalari: yoqish uchun true (hozircha o'chiq)
AI_ENABLED=false
# AI: Vercel'da OIDC orqali avtomatik. Lokal ishlash uchun ulardan biri:
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
# AI_MODEL=anthropic/claude-sonnet-5.5

# 3-bosqich: nashr qilish
# Platformaning asosiy domeni (wildcard *.domen Vercel'ga ulanganda subdomenlar ishlaydi), masalan tezdokon.uz
NEXT_PUBLIC_ROOT_DOMAIN=
# O'z domenini ulash uchun Vercel API (maxfiy token: Vercel → Account Settings → Tokens)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
